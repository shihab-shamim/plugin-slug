{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "icb/fold-out-reveal",
	"version": "1.0.0",
	"title": "Live Chats",
	"category": "widgets",
	"description": "Live Chats is a WordPress plugin that allows you to add interactive live chat widgets to your website.",
	"keywords": [
		"Live Chats",
		"live chat",
		"chat",
		"support"
	],
	"textdomain": "live-chats",
	"attributes": {
		"alignment": {
			"type": "string",
			"default": "center"
		},
		"purposeType": {
			"type": "string",
			"default": "test"
		},
		"colors":{
			"type":"object",
			"default":{
				"color": "black",
				"bg": "#B1C5A4"
			}
		}
	},
	"supports": {
		"align": [
			"wide",
			"full"
		],
		"html": false
	},
	"example": {
		"attributes": {}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./view.css",
	"render": "file:./render.php",
	"viewScript": "file:./view.js"
}